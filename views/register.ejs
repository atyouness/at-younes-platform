<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | آت يونس تك</title>
  <link rel="stylesheet" href="/css/site-shell.css">
  <style>body{margin:0;background:#f5f7f6}.box{background:#fff;width:min(460px,calc(100% - 32px));margin:48px auto;padding:28px;border-radius:6px;box-shadow:0 8px 30px #0001}label{display:block;margin:12px 0 6px}input{width:100%;box-sizing:border-box;padding:11px;border:1px solid #ccd3da;border-radius:6px}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:6px;background:#16715b;color:#fff;font-size:16px;cursor:pointer}.message{margin-top:14px;color:#a33}.link{display:block;margin-top:16px}</style>
</head>
<body>
  <header class="site-header"><div class="site-header__inner"><a class="site-brand" href="/">آت يونس <span>تك</span></a><nav class="site-nav" aria-label="التنقل الرئيسي"><a href="/">الرئيسية</a><a href="/products.html">العروض</a><a href="/login">دخول</a></nav></div></header>
  <main class="box">
    <h1>إنشاء حساب</h1>
    <form id="register-form">
      <label for="firstName">الاسم الأول</label><input id="firstName" name="firstName" required>
      <label for="lastName">اللقب</label><input id="lastName" name="lastName" required>
      <label for="username">اسم المستخدم</label><input id="username" name="username" autocomplete="username">
      <label for="email">البريد الإلكتروني</label><input id="email" name="email" type="email" required autocomplete="email">
      <label for="phone">الهاتف</label><input id="phone" name="phone" type="tel">
      <label for="password">كلمة المرور</label><input id="password" name="password" type="password" minlength="8" required autocomplete="new-password">
      <label for="referralCode">كود الإحالة</label><input id="referralCode" name="referralCode">
      <button type="submit">إنشاء الحساب</button>
    </form>
    <p id="message" class="message" role="alert"></p>
    <a class="link" href="/login">لديك حساب؟ تسجيل الدخول</a>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div><h2>آت يونس تك</h2><p>منصة جزائرية للترويج والمشاركة في المشاريع والعروض المحلية.</p></div><div class="site-footer__links"><a href="/">الرئيسية</a><a href="/login">تسجيل الدخول</a></div></div><div class="site-footer__bottom">© 2026 آت يونس تك. جميع الحقوق محفوظة.</div></footer>
  <script>
    document.getElementById('register-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = document.getElementById('message');
      const body = Object.fromEntries(new FormData(event.currentTarget));
      const response = await fetch('/api/auth/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await response.json();
      if (!response.ok) { message.textContent = data.message || 'تعذر إنشاء الحساب'; return; }
      localStorage.setItem('token', data.token);
      window.location.href = '/';
    });
  </script>
</body>
</html>
